# Database (Neon Postgres)
POSTGRES_URL=postgresql://user:password@host/dbname

# LLM Provider: "openai" (default) hoặc "anthropic"
LLM_PROVIDER=openai

# LLM — OpenAI-compatible (OpenAI, Groq, Together, Ollama, v.v.)
# Nếu LLM_PROVIDER=anthropic: LLM_BASE_URL không cần, LLM_MODEL mặc định claude-sonnet-4-20250514
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# Image Generation (mặc định dùng LLM_API_KEY nếu không set riêng)
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-...
# IMAGE_MODEL=dall-e-3

# TTS — Video Reels voiceover (hiện chỉ hỗ trợ OpenAI)
OPENAI_API_KEY=sk-...

# Gemini fallback (dùng khi LLM lỗi cho video extract)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Social Media Scraping
RAPID_API_KEY=
BRAVE_API_KEY=

# Facebook Graph API
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_USER_TOKEN=
